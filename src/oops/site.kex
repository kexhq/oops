# Writes the site: an index of every code by stage, and a page per code at
# `<CODE>/index.html`, so `https://oops.kex.run/KEXET-0001` is that page.

module Oops.Site do
  using Oops.Registry, only: [Entry, Registry]
  using Markdown
  using Regex
  using URI

  # One stage's codes, as the index lists them.
  record Section do
    anchor : String
    title : String
    rows : [Row]
  end

  # One line of the index.
  record Row do
    code : String
    severity : String
    href : String
    # The message, already escaped, with its slots marked.
    message : String
  end

  # What a page says about itself in its <head>: to search engines, to the
  # sites that unfurl a link into a card, and to programs after its text.
  record Head do
    title : String
    # One or two sentences, what a search result shows under the title.
    description : String
    # The page's canonical URL, or empty for a page no search engine
    # should list (the 404).
    url : String
    # Open Graph's kind of page: `website` or `article`.
    kind : String
    # The path of the page's Markdown twin.
    markdown : String
    # Schema.org JSON-LD, ready to sit inside a <script>, or empty.
    data : String
  end

  # Where the site's pieces are read from and written to.
  record Paths do
    # The site's root, written from scratch.
    out : String
    # The hand-written explanations, `<CODE>.md` each.
    codes : String
    # The stylesheets and the icon, copied as they are.
    assets : String
  end

  # Writes the whole site for +registry+ under +paths.out+.
  #
  # @return [Result<Integer, String>] how many pages were written
  write : Registry -> Paths -> Result<Integer, String>
  foul write(registry, paths) do
    FS.Directory.create(FS.Path.join(paths.out, "assets")).mapError(~describe).try
    copyAssets(paths).try
    let index = indexPage(registry)
    put(FS.Path.join(paths.out, "index.html"), index).try
    put(FS.Path.join(paths.out, "404.html"), notFoundPage()).try
    put(FS.Path.join(paths.out, "CNAME"), "oops.kex.run\n").try
    put(FS.Path.join(paths.out, "registry.json"), registry.source).try
    let explained = registry.entries.map { |entry| (entry, explanationSource(entry, paths)) }
    explained.each do |entry, source|
      let dir = FS.Path.join(paths.out, entry.code)
      FS.Directory.create(dir).mapError(~describe).try
      let html = source.empty? then "" else Markdown.toHtml(source)
      put(FS.Path.join(dir, "index.html"), codePage(entry, html)).try
      put(FS.Path.join(paths.out, "${entry.code}.md"), Oops.Text.codePage(entry, source)).try
    end
    put(FS.Path.join(paths.out, "llms.txt"), Oops.Text.index(registry)).try
    put(FS.Path.join(paths.out, "llms-full.txt"), Oops.Text.full(registry, explained)).try
    put(FS.Path.join(paths.out, "sitemap.xml"), sitemap(registry.entries)).try
    put(FS.Path.join(paths.out, "robots.txt"), "User-agent: *\nAllow: /\nSitemap: ${site}/sitemap.xml\n").try
    return Ok(registry.entries.count + 2)
  end

  foul put(path: String, text: String) -> Result<Void, String> do
    return FS.File.write(path, text).mapError { |error| "cannot write ${path}: ${error}" }
  end

  let describe(error: Any) -> String = "${error}"

  foul copyAssets(paths: Paths) -> Result<Void, String> do
    let names = FS.Directory.files(paths.assets).mapError(~describe).try
    names.each do |name|
      let from = FS.Path.join(paths.assets, name)
      let to = name == "icon.png" then FS.Path.join(paths.out, name)
        else FS.Path.join(FS.Path.join(paths.out, "assets"), name)
      let bytes = FS.File.readBytes(from).mapError(~describe).try
      FS.File.writeBytes(to, bytes).mapError(~describe).try
    end
    return Ok(())
  end

  # The hand-written explanation of +entry+, the Markdown of
  # `codes/<CODE>.md` without its front matter, or empty when nobody has
  # written one.
  foul explanationSource(entry: Entry, paths: Paths) -> String do
    let source = FS.Path.join(paths.codes, "${entry.code}.md")
    return FS.File.read(source).map { |text| Oops.Text.withoutFrontMatter(text) }.or("")
  end

  foul indexPage(registry: Registry) -> String do
    let render = Template.html(Kex.embed("templates/index.html.ket"))
    let errors = registry.entries.count { |e| e.severity == "error" }
    let content = render(
      registry.version,
      errors,
      registry.entries.count - errors,
      sections(registry.entries),
      registry.retired
    )
    let description = "Every error and warning the Kex compiler reports, by its stable code: what each means, an example that causes it, and how to fix it."
    let data = jsonLd({
      "@context": "https://schema.org",
      "@type": "WebSite",
      "name": "Kex errors and warnings",
      "url": "${site}/",
      "description": description,
      "inLanguage": "en",
      "isPartOf": { "@type": "WebSite", "name": "Kex", "url": "https://kex.run/" }
    })
    let head = Head {
      title: "Kex errors and warnings: every compiler diagnostic, by code",
      description: description,
      url: "${site}/",
      kind: "website",
      markdown: "/llms.txt",
      data: data
    }
    return layout(head, "", content)
  end

  foul codePage(entry: Entry, explanation: String) -> String do
    let render = Template.html(Kex.embed("templates/code.html.ket"))
    let content = render(
      entry.code,
      entry.name,
      entry.severity,
      Oops.Registry.stageTitle(entry.stage),
      marked(entry.template),
      explanation,
      contributeLink(entry.code, explanation.empty?),
      reportLink(entry)
    )
    let kind = entry.severity == "error" then "error" else "warning"
    let title = "${entry.code}: ${entry.name} | Kex ${kind}"
    let description = codeDescription(entry, explanation)
    let url = "${site}/${entry.code}/"
    let stage = Oops.Registry.stageTitle(entry.stage)
    let data = jsonLd({
      "@context": "https://schema.org",
      "@graph": [
        {
          "@type": "TechArticle",
          "headline": "${entry.code}: ${entry.name}",
          "description": description,
          "url": url,
          "inLanguage": "en",
          "about": "The Kex compiler's ${kind} ${entry.code}, ${entry.template}",
          "isPartOf": { "@type": "WebSite", "name": "Kex errors and warnings", "url": "${site}/" }
        },
        {
          "@type": "BreadcrumbList",
          "itemListElement": [
            { "@type": "ListItem", "position": 1, "name": "All codes", "item": "${site}/" },
            { "@type": "ListItem", "position": 2, "name": stage, "item": "${site}/#${entry.stage}" },
            { "@type": "ListItem", "position": 3, "name": entry.code, "item": url }
          ]
        }
      ]
    })
    let head = Head {
      title: title, description: description, url: url, kind: "article",
      markdown: "/${entry.code}.md", data: data
    }
    return layout(head, "../", content)
  end

  let site -> String = "https://oops.kex.run"

  # What a search result says under a code's title: the severity, the
  # message, then the start of the explanation's first paragraph.
  let codeDescription(entry: Entry, explanation: String) -> String do
    let kind = entry.severity == "error" then "error" else "warning"
    let lead = "Kex ${kind} ${entry.code} (${entry.name}): \u{201C}${entry.template}\u{201D}."
    let first = firstParagraph(explanation)
    let stage = Oops.Registry.stageTitle(entry.stage).lowerCase
    let rest = first.empty? then " Reported at the compiler's ${stage} stage." else " ${first}"
    clip(lead + rest, 200)
  end

  # The text of the first paragraph of +html+, the explanation as the page
  # shows it, tags and entities left out.
  let firstParagraph(html: String) -> String do
    let found = html.scan(re`<p>([\s\S]*?)</p>`).first
    let inner = found.map { |m| m.get(1, "") }.or("")
    let text = inner.replace(re`<[^>]+>`) { |_| "" }
      .replace("&lt;", "<").replace("&gt;", ">").replace("&quot;", "\"")
      .replace("&#39;", "'").replace("&amp;", "&")
    text.replace(re`\s+`) { |_| " " }.trim
  end

  # +text+ cut to at most +limit+ characters, at a word, with an ellipsis
  # when anything was cut.
  let clip(text: String, limit: Integer) -> String do
    return text if text.count <= limit
    let cut = text.take(limit - 1).replace(re`\s+\S*$`) { |_| "" }
    "${cut.replace(re`[\s,.:;]+$`) { |_| "" }}\u{2026}"
  end

  # +value+ as JSON that can sit inside a <script>: no `</` to end it early.
  let jsonLd(value: Any) -> String = JSON.stringify(value).replace("</", "<\\/")

  # Every page a search engine should know about: the index and each code.
  let sitemap(entries: [Entry]) -> String do
    let urls = ["${site}/", ...entries.map { |e| "${site}/${e.code}/" }]
      .map { |url| "  <url><loc>${url}</loc></url>" }
    "<?xml version=\"1.0\" encoding=\"UTF-8\"?>\n<urlset xmlns=\"http://www.sitemaps.org/schemas/sitemap/0.9\">\n${urls.join("\n")}\n</urlset>\n"
  end

  foul notFoundPage() -> String do
    let content = `
      <h1>Not a code</h1>
      <p class="lede">No diagnostic has that code. <a href="/index.html">Every code</a> is listed on the front page.</p>
    `
    let head = Head {
      title: "Not found | Kex errors and warnings",
      description: "No diagnostic has that code.",
      url: "",
      kind: "website",
      markdown: "/llms.txt",
      data: ""
    }
    return layout(head, "/", content)
  end

  foul layout(head: Head, root: String, content: String) -> String do
    let render = Template.html(Kex.embed("templates/layout.html.ket"))
    return render(head, root, content)
  end

  foul sections(entries: [Entry]) -> [Section] do
    return Oops.Registry.stages(entries).map do |stage|
      let rows = Oops.Registry.inStage(entries, stage).map do |e|
        Row { code: e.code, severity: e.severity, href: "${e.code}/", message: marked(e.template) }
      end
      Section { anchor: stage, title: Oops.Registry.stageTitle(stage), rows: rows }
    end
  end

  # The template escaped for HTML, each `{slot}` in a span the stylesheet
  # sets apart: it is where the compiler writes a name or a type.
  foul marked(template: String) -> String do
    return Template.escapeHtml(template).replace(re`\{([a-zA-Z_]+)\}`) do |m|
      "<span class=\"slot\">${m.get(1, "")}</span>"
    end
  end

  # A link that opens GitHub's editor on this code's explanation: a new file
  # when there is none, the existing one otherwise.
  foul contributeLink(code: String, missing: Bool) -> String do
    let repository = "https://github.com/kexhq/oops"
    return missing then "${repository}/new/main/codes?filename=${code}.md"
      else "${repository}/edit/main/codes/${code}.md"
  end

  # A link that opens a new kexhq/kex issue about this diagnostic: reported
  # when it should not be, missing when it should be, or saying the wrong
  # thing. The title and body are filled in for the reporter to finish.
  let reportLink(entry: Entry) -> String do
    let body = [
      "Diagnostic: [${entry.code}](https://oops.kex.run/${entry.code}/) (`${entry.name}`)",
      "Kex version (`kex --version`): ",
      "",
      "### The program",
      "",
      "`".repeat(3) + "kex",
      "",
      "`".repeat(3),
      "",
      "### What the compiler printed",
      "",
      "### What you expected",
      ""
    ].join("\n")
    let query = Query.from([
      ("title", Just("${entry.code}: ")),
      ("body", Just(body)),
      ("labels", Just("Error handling & reporting"))
    ])
    "https://github.com/kexhq/kex/issues/new?${query.encode}"
  end
end

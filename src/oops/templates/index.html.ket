---
params: [version: String, errors: Integer, warnings: Integer, explained: Integer, sections: [Section], retired: [String]]
---
<h1>Errors and warnings</h1>
<p class="lede">Every diagnostic the Kex compiler reports, by its code. Kex <%= version %> knows <%= errors %> errors and <%= warnings %> warnings. A diagnostic links here as <code>https://oops.kex.run/&lt;code&gt;</code>; <code>kex --explain &lt;code&gt;</code> says the same in a terminal.</p>
<p><%= explained %> of the <%= errors + warnings %> codes have a written explanation, marked <span class="explained" title="Explained">&#9679;</span> below; <a href="#stats">by stage</a>.</p>
<nav class="stages">
<% sections.map do |section| %>
  <a href="#<%= section.anchor %>"><%= section.title %> <span class="count"><%= section.rows.count %></span></a>
<% end %>
</nav>
<% sections.map do |section| %>
<section class="stage" id="<%= section.anchor %>">
  <h2><%= section.title %></h2>
  <table class="codes">
    <tbody>
<% section.rows.map do |row| %>
      <tr class="<%= row.severity %>">
        <td class="code"><a href="<%= row.href %>"><%= row.code %></a><% if row.explained %> <span class="explained" title="Explained">&#9679;</span><% end %></td>
        <td class="message"><%== row.message %></td>
      </tr>
<% end %>
    </tbody>
  </table>
</section>
<% end %>
<section class="stage" id="stats">
  <h2>By stage</h2>
  <table class="stats">
    <thead>
      <tr><th>Stage</th><th>Codes</th><th>Errors</th><th>Warnings</th><th>Explained</th></tr>
    </thead>
    <tbody>
<% sections.map do |section| %>
      <tr>
        <td><a href="#<%= section.anchor %>"><%= section.title %></a></td>
        <td><%= section.rows.count %></td>
        <td><%= section.rows.count { |r| r.severity == "error" } %></td>
        <td><%= section.rows.count { |r| r.severity == "warning" } %></td>
        <td><%= section.explained %></td>
      </tr>
<% end %>
    </tbody>
    <tfoot>
      <tr><td>All</td><td><%= errors + warnings %></td><td><%= errors %></td><td><%= warnings %></td><td><%= explained %></td></tr>
    </tfoot>
  </table>
</section>
<% if retired.count > 0 %>
<section class="stage" id="retired">
  <h2>Retired</h2>
  <p>No longer reported, and never given to another diagnostic: <% retired.map do |code| %><code><%= code %></code> <% end %></p>
</section>
<% end %>
